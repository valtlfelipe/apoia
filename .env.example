# Copy this file to .env and fill in the values.
# See README.md for detailed explanations.

# ── Site ─────────────────────────────────────────────────────────────────
# Absolute URL this instance is served from (used for metadata/OG tags, and
# as the OAuth redirect origin for the /admin login below).
APOIA_SITE_URL="http://localhost:3000"
# Max POSTs to /api/support per IP per minute.
APOIA_RATE_LIMIT_PER_MINUTE="5"

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_PATH="./data/apoia.db"

# ── Pix provider ─────────────────────────────────────────────────────────
# Which module in lib/pix/providers to use: "woovi" or "abacatepay". Only the
# selected one's variables are required; the other block can stay empty.
PIX_PROVIDER="woovi"

# --- Woovi (https://woovi.com) -------------------------------------------
# Get this from the Woovi dashboard → Applications.
WOOVI_APP_ID=""
WOOVI_API_URL="https://api.woovi.com/api/v1"
# Optional: a shared token Woovi will echo back in the webhook's Authorization
# header, as an extra check alongside signature verification.
WOOVI_WEBHOOK_TOKEN=""
# The public key that verifies the webhook signature is not configured here:
# it's fetched from WOOVI_API_URL/webhook/public-keys and cached for an hour,
# so a key rotation on Woovi's side is picked up without a redeploy.

# --- AbacatePay (https://abacatepay.com) ---------------------------------
# Get this from the AbacatePay dashboard → API keys. A devMode key routes
# everything to the sandbox; the URL is the same either way.
ABACATEPAY_API_KEY=""
ABACATEPAY_API_URL="https://api.abacatepay.com/v2"
# Required with this provider: the secret AbacatePay appends to the webhook
# URL as ?webhookSecret=... — the same value you pass when registering the
# webhook. It's what authenticates a delivery (their HMAC key is public), so
# generate a strong one: openssl rand -base64 32
ABACATEPAY_WEBHOOK_SECRET=""
# Optional: override AbacatePay's published HMAC key used to check the webhook
# signature — only needed if they rotate it.
ABACATEPAY_WEBHOOK_PUBLIC_KEY=""

# ── Admin ────────────────────────────────────────────────────────────────
# Required: /admin (login with Google, via shoo.dev — see README.md) is
# where you manage creator identity, products, the support form, and
# supports — there's no ENV equivalent for any of that.
#
# APOIA_ADMIN_EMAIL: the only Google account allowed to sign in.
APOIA_ADMIN_EMAIL="you@example.com"
# APOIA_ADMIN_SECRET: signs your admin session cookie. Generate with:
#   openssl rand -base64 32
APOIA_ADMIN_SECRET=""
