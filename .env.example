# Copy this file to .env and fill in the values.
# See README.md for detailed explanations.

# Absolute URL this instance is served from (used for metadata/OG tags, and
# as the OAuth redirect origin if /admin is enabled below).
APOIA_SITE_URL="http://localhost:3000"

# ── Support form ─────────────────────────────────────────────────────────
# Suggested amounts, min/max, the timeline checkboxes, avatar style, and Pix
# charge validity all moved to /admin/settings — see README.md. Without
# admin enabled, the app uses its code defaults (R$5/15/25 presets, R$1 min,
# R$10000 max, timeline checkbox checked, count shown, total hidden,
# "notionists" avatar style, 30-minute charge validity).
#
# Shown in the success dialog once a payment is confirmed. {amount} is
# replaced with the paid value (e.g. "R$ 25,00").
APOIA_THANK_YOU_MESSAGE="Seu apoio de {amount} chegou certinho. Muito obrigado."
# Max POSTs to /api/support per IP per minute.
APOIA_RATE_LIMIT_PER_MINUTE="5"

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_PATH="./data/apoia.db"

# ── Pix provider ─────────────────────────────────────────────────────────
# Which module in lib/pix/providers to use. Currently only "woovi".
PIX_PROVIDER="woovi"

# Woovi (https://woovi.com) — get this from the Woovi dashboard → Applications.
WOOVI_APP_ID=""
WOOVI_API_URL="https://api.woovi.com/api/v1"
# Optional: a shared token Woovi will echo back in the webhook's Authorization
# header, as an extra check alongside signature verification.
WOOVI_WEBHOOK_TOKEN=""
# Optional: override Woovi's public key (base64) used to verify webhook
# signatures — only needed if Woovi rotates it or for a sandbox environment.
WOOVI_WEBHOOK_PUBLIC_KEY=""

# ── Admin (optional) ─────────────────────────────────────────────────────
# Manages creator identity (name, tagline, avatar, links), products (the
# /<slug> pages), support-form config (amounts, timeline checkboxes, avatar
# style, charge validity), and lets you see/hide supports — see README.md
# for details. Both required together to turn on /admin; leave both unset
# (default) to keep it fully off, with every /admin route 404ing — the app
# then runs with its code defaults (creator name "Apoia", no products).
#
# APOIA_ADMIN_EMAIL: the only Google account allowed to sign in.
# APOIA_ADMIN_SECRET: signs your admin session cookie. Generate with:
#   openssl rand -base64 32
# APOIA_ADMIN_EMAIL="you@example.com"
# APOIA_ADMIN_SECRET=""
