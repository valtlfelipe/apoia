# Copy this file to .env and fill in the values.
# See README.md for detailed explanations.

# ── Creator ──────────────────────────────────────────────────────────────
# The person (or org) receiving support. Shown on every page.
APOIA_CREATOR_NAME="Felipe Valtl de Mello"
# Optional: short form used in page headlines, where the full name would be
# too long ("Apoie {short} no desenvolvimento do X"). Defaults to the first
# word of APOIA_CREATOR_NAME.
APOIA_CREATOR_SHORT_NAME="Felipe"
APOIA_CREATOR_TAGLINE="Construindo em público, em open source"
# Optional: absolute URL to a custom avatar image. Leave empty to use a
# generated DiceBear avatar based on the creator name. Its origin is
# automatically allow-listed in the CSP img-src.
APOIA_CREATOR_AVATAR_URL=""
# JSON array of { label, url } shown as links under the creator name.
APOIA_CREATOR_LINKS='[{"label":"GitHub","url":"https://github.com/your-user"}]'
# Absolute URL this instance is served from (used for metadata/OG tags).
APOIA_SITE_URL="http://localhost:3000"

# ── Products (optional) ─────────────────────────────────────────────────
# JSON array of { slug, name, headline?, description? }. Each product gets
# its own page at /<slug> with a tailored headline. `headline` may use
# {creator} and {product} placeholders. Leave empty ("[]") to only offer
# generic support at the root page.
APOIA_PRODUCTS='[{"slug":"financeiro","name":"Financeiro","headline":"Apoie {creator} no desenvolvimento do {product}","description":"Um app de finanças pessoais."}]'

# ── Support form ─────────────────────────────────────────────────────────
# Suggested amounts, in cents, shown as quick-pick buttons.
APOIA_AMOUNT_PRESETS="500,1500,2500"
APOIA_MIN_AMOUNT_CENTS="100"
APOIA_MAX_AMOUNT_CENTS="1000000"
# Whether the "appear in the timeline" checkbox starts checked.
APOIA_DEFAULT_PUBLIC="true"
APOIA_SHOW_TOTAL_COUNT="true"
APOIA_SHOW_TOTAL_AMOUNT="false"
# Any style exported by @dicebear/collection (e.g. notionists, thumbs, bottts).
APOIA_AVATAR_STYLE="notionists"
# Shown in the success dialog once a payment is confirmed. {amount} is
# replaced with the paid value (e.g. "R$ 25,00").
APOIA_THANK_YOU_MESSAGE="Seu apoio de {amount} chegou certinho. Muito obrigado."
# How long a Pix charge stays valid, in seconds.
APOIA_CHARGE_EXPIRES_IN="1800"
# Max POSTs to /api/support per IP per minute.
APOIA_RATE_LIMIT_PER_MINUTE="5"
# DEV ONLY. Never set to true in production — this disables webhook signature
# verification, letting anyone fake a payment confirmation.
APOIA_DEV_SKIP_WEBHOOK_SIGNATURE="false"

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_PATH="./data/apoia.db"

# ── Pix provider ─────────────────────────────────────────────────────────
# Which module in lib/pix/providers to use. Currently only "woovi".
PIX_PROVIDER="woovi"

# Woovi (https://woovi.com) — get this from the Woovi dashboard → Applications.
WOOVI_APP_ID=""
WOOVI_API_URL="https://api.woovi.com/api/v1"
# Optional: a shared token Woovi will echo back in the webhook's Authorization
# header, as an extra check alongside signature verification.
WOOVI_WEBHOOK_TOKEN=""
# Optional: override Woovi's public key (base64) used to verify webhook
# signatures — only needed if Woovi rotates it or for a sandbox environment.
WOOVI_WEBHOOK_PUBLIC_KEY=""
